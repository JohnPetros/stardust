{
  "name": "stardust",
  "version": "1.8.0",
  "description": "Educational platform for logic programming learning.",
  "repository": {
    "type": "git",
    "url": "https://github.com/JohnPetros/stardust"
  },
  "author": "João Pedro Carvalho dos Santos",
  "email": "joaopedrocarvalho@gmail.com",
  "homepage": "https://stardust-app.com.br",
  "contributors": [
    {
      "name": "Leonel Sanches da Silva",
      "url": "https://www.linkedin.com/in/leonelsanchesdasilva/"
    }
  ],
  "license": "MIT",
  "private": true,
  "engines": {
    "node": ">=22"
  },
  "packageManager": "pnpm@11.28.11",
  "scripts": {
    "setup": "node ./scripts/setup-project.mjs",
    "penpot": "node ./scripts/open-penpot.mjs",
    "prepare": "husky",
    "prod": "turbo prod",
    "dev": "turbo dev --filter=!@stardust/crew --filter=!@stardust/studio",
    "build": "turbo build && node ./scripts/replace-packages-imports.mjs",
    "build:server": "turbo build --filter=@stardust/server --no-cache && node ./scripts/replace-packages-imports.mjs",
    "build:backoffice": "turbo build --filter=@stardust/backoffice",
    "build:web": "turbo build --filter=@stardust/web",
    "build:core": "turbo build --filter=@stardust/core",
    "build:lsp": "turbo build --filter=@stardust/lsp",
    "test": "pnpm run test:unit",
    "format": "turbo format",
    "check:code": "turbo check:code",
    "check:types": "turbo check:types",
    "check:architecture": "depcruise --config .dependency-cruiser.cjs packages/core/src apps/server/src apps/web/src apps/backoffice/src && pnpm --filter @stardust/crew run check:architecture",
    "test:coverage": "turbo test:coverage",
    "check:coverage": "node ./scripts/check-coverage-baseline.mjs",
    "check:complexity": "node ./scripts/check-complexity.mjs",
    "update:complexity-baseline": "node ./scripts/check-complexity.mjs --update-baseline",
    "check:test-integrity": "node ./scripts/check-test-integrity.mjs",
    "check:spec-implementation": "node ./scripts/check-spec-implementation.mjs",
    "check:design": "node ./scripts/check-design.mjs",
    "update:design-baseline": "node ./scripts/check-design.mjs --update-baseline",
    "test:unit": "turbo test:unit",
    "test:integration": "turbo test:integration",
    "test:scripts": "node --test scripts/tests/*.test.mjs",
    "test:server": "turbo test:unit --filter=@stardust/server",
    "test:backoffice": "turbo test:unit --filter=@stardust/backoffice",
    "test:web": "turbo test:unit --filter=@stardust/web",
    "test:core": "turbo test:unit --filter=@stardust/core",
    "crew": "pnpm --filter @stardust/crew run dev",
    "build:crew": "pnpm --filter @stardust/crew run build",
    "dev:backoffice": "pnpm --filter @stardust/backoffice run dev",
    "dev:studio": "pnpm --filter @stardust/studio run dev",
    "build:studio": "turbo build --filter=@stardust/studio"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.7",
    "@commitlint/cli": "^19.8.1",
    "@commitlint/config-conventional": "^19.8.1",
    "@mastra/core": "1.83.0",
    "@react-three/fiber": "9.8.2",
    "@tiptap/core": "3.33.1",
    "@tiptap/pm": "3.33.1",
    "@types/react": "19.3.0",
    "apexcharts": "6.10.0",
    "code-multivitals": "1.6.2",
    "commitlint-config-git-commit-emoji": "^1.0.0",
    "dependency-cruiser": "^18.7.2",
    "hono": "4.13.18",
    "husky": "^9.1.7",
    "immer": "11.2.10",
    "istanbul-lib-coverage": "3.2.2",
    "monaco-editor": "0.57.0",
    "postcss": "8.5.32",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-router": "8.5.1",
    "three": "0.187.0",
    "ts-jest-mocker": "^1.3.0",
    "tsx": "^4.23.15",
    "turbo": "2.11.11",
    "vite": "8.3.8",
    "zod": "4.4.3"
  },
  "dependencies": {
    "@ai-sdk/provider-utils-v5": "npm:@ai-sdk/provider-utils@5.0.5",
    "@aws-sdk/client-s3": "3.1168.0",
    "@designliquido/delegua": "^1.25.1",
    "@faker-js/faker": "8.4.1",
    "drizzle-orm": "0.45.4",
    "postgres": "3.4.9"
  }
}

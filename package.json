{
  "name": "stardust",
  "version": "1.7.4",
  "description": "Educational platform for logic programming learning.",
  "repository": {
    "type": "git",
    "url": "https://github.com/JohnPetros/stardust"
  },
  "author": "João Pedro Carvalho dos Santos",
  "email": "joaopedrocarvalho@gmail.com",
  "homepage": "https://stardust-app.com.br",
  "contributors": [
    {
      "name": "Leonel Sanches da Silva",
      "url": "https://www.linkedin.com/in/leonelsanchesdasilva/"
    }
  ],
  "license": "MIT",
  "private": true,
  "engines": {
    "node": ">=22"
  },
  "packageManager": "npm@10.9.3",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "prod": "turbo prod",
    "dev": "turbo dev",
    "build:server": "turbo build --filter=@stardust/server --no-cache && /bin/sh ./scripts/replace-packages-imports.sh",
    "build:studio": "turbo build --filter=@stardust/studio",
    "build:web": "turbo build --filter=@stardust/web",
    "build:core": "turbo build --filter=@stardust/core",
    "test": "npm run test:unit",
    "test:unit": "turbo test:unit",
    "test:integration": "turbo test:integration --filter=@stardust/server",
    "test:server": "turbo test:unit --filter=@stardust/server",
    "test:studio": "turbo test:unit --filter=@stardust/studio",
    "test:web": "turbo test:unit --filter=@stardust/web",
    "test:core": "turbo test:unit --filter=@stardust/core",
    "test:harness": "npm run test:unit -w @stardust/harness",
    "codecheck": "turbo codecheck",
    "codecheck:harness": "npm run codecheck -w @stardust/harness",
    "codecheck:quality-ratchet": "npm run codecheck -w @stardust/harness",
    "typecheck": "turbo typecheck",
    "typecheck:harness": "npm run typecheck -w @stardust/harness",
    "typecheck:quality-ratchet": "npm run typecheck -w @stardust/harness",
    "spec-check": "npm run harness -- check spec",
    "readiness-check": "npm run harness -- check readiness",
    "scope-check": "npm run harness -- check scope",
    "architecture-check": "npm run harness -- check architecture",
    "runtime-smoke": "npm run harness -- check runtime",
    "dead-code-check": "npm run harness -- check dead-code",
    "migration-check": "npm run harness -- check migration",
    "contract-check": "npm run harness -- check contract",
    "harness": "tsx packages/harness/src/cli.ts",
    "quality-ratchet": "npm run harness -- quality-ratchet",
    "release": "./scripts/release.sh",
    "changelog": "./scripts/update-changelog.sh"
  },
  "devDependencies": {
    "@biomejs/biome": "2.3.15",
    "@commitlint/cli": "^19.8.1",
    "@commitlint/config-conventional": "^19.8.1",
    "commitlint-config-git-commit-emoji": "^1.0.0",
    "dependency-cruiser": "^18.1.0",
    "husky": "^9.1.7",
    "knip": "^6.29.0",
    "release-it": "^20.2.1",
    "ts-jest-mocker": "^1.3.0",
    "tsx": "^4.21.0",
    "turbo": "2.10.2"
  },
  "dependencies": {
    "@ai-sdk/provider-utils-v5": "npm:@ai-sdk/provider-utils@^5.0.5",
    "@designliquido/delegua": "^1.25.1",
    "@faker-js/faker": "8.4.1"
  },
  "overrides": {
    "@ai-sdk/provider-utils": "5.0.5",
    "@ai-sdk/ui-utils": {
      "@ai-sdk/provider-utils": "5.0.5"
    },
    "@mastra/core": "1.25.0",
    "@mastra/core@1.25.0": {
      "@ai-sdk/provider-utils-v5": "npm:@ai-sdk/provider-utils@5.0.5",
      "@ai-sdk/ui-utils-v5": {
        "@ai-sdk/provider-utils": "5.0.5"
      }
    },
    "@mastra/server": "1.25.0",
    "esbuild": "0.28.1",
    "tsup": {
      "esbuild": "0.28.1"
    },
    "uuid": "11.1.1",
    "vite": "6.4.3"
  }
}
{
  "name": "stardust",
  "version": "1.8.0",
  "description": "Educational platform for logic programming learning.",
  "repository": {
    "type": "git",
    "url": "https://github.com/JohnPetros/stardust"
  },
  "author": "João Pedro Carvalho dos Santos",
  "email": "joaopedrocarvalho@gmail.com",
  "homepage": "https://stardust-app.com.br",
  "contributors": [
    {
      "name": "Leonel Sanches da Silva",
      "url": "https://www.linkedin.com/in/leonelsanchesdasilva/"
    }
  ],
  "license": "MIT",
  "private": true,
  "engines": {
    "node": ">=22"
  },
  "packageManager": "npm@10.9.3",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "setup": "node ./scripts/setup-project.mjs",
    "prepare": "husky",
    "prod": "turbo prod",
    "dev": "turbo dev",
    "build": "turbo build && node ./scripts/replace-packages-imports.mjs",
    "build:server": "turbo build --filter=@stardust/server --no-cache && node ./scripts/replace-packages-imports.mjs",
    "build:studio": "turbo build --filter=@stardust/studio",
    "build:web": "turbo build --filter=@stardust/web",
    "build:core": "turbo build --filter=@stardust/core",
    "build:lsp": "turbo build --filter=@stardust/lsp",
    "test": "npm run test:unit",
    "format": "turbo format",
    "check:code": "turbo check:code",
    "check:types": "turbo check:types",
    "check:architecture": "depcruise --config .dependency-cruiser.cjs packages/core/src apps/server/src apps/web/src apps/studio/src",
    "check:dependencies-update": "npm run check:code && npm run check:types && npm run check:architecture && npm run build:lsp && npm run test:unit && npm run test:integration && npm run build",
    "check:dependencies-update:doctor": "npm run check:code && npm run check:types && npm run check:architecture && npm run build:lsp && npm run test:unit",
    "test:coverage": "turbo test:coverage",
    "check:coverage": "node ./scripts/check-coverage-baseline.mjs",
    "check:test-integrity": "node ./scripts/check-test-integrity.mjs",
    "check:spec-definition": "node ./scripts/check-spec-definition.mjs",
    "check:plan-definition": "node ./scripts/check-plan-definition.mjs",
    "check:spec-implementation": "node ./scripts/check-spec-implementation.mjs",
    "test:unit": "turbo test:unit",
    "test:integration": "turbo test:integration",
    "test:scripts": "node --test scripts/tests/*.test.mjs",
    "test:server": "turbo test:unit --filter=@stardust/server",
    "test:studio": "turbo test:unit --filter=@stardust/studio",
    "test:web": "turbo test:unit --filter=@stardust/web",
    "test:core": "turbo test:unit --filter=@stardust/core"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.7",
    "@commitlint/cli": "^19.8.1",
    "@commitlint/config-conventional": "^19.8.1",
    "@react-three/fiber": "9.7.0",
    "@tiptap/core": "3.29.2",
    "@tiptap/pm": "3.29.2",
    "commitlint-config-git-commit-emoji": "^1.0.0",
    "dependency-cruiser": "^18.1.0",
    "hono": "4.13.1",
    "husky": "^9.1.7",
    "@types/react": "19.2.18",
    "monaco-editor": "0.56.0",
    "react-router": "8.3.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "three": "0.185.1",
    "ts-jest-mocker": "^1.3.0",
    "tsx": "^4.21.0",
    "turbo": "2.10.8",
    "vite": "8.2.2"
  },
  "dependencies": {
    "@ai-sdk/provider-utils-v5": "npm:@ai-sdk/provider-utils@^5.0.5",
    "@designliquido/delegua": "^1.25.1",
    "@faker-js/faker": "8.4.1"
  },
  "overrides": {
    "@ai-sdk/provider-utils": "5.0.5",
    "@types/react": "19.2.18",
    "hono": "4.13.1",
    "monaco-editor": "0.56.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "@ai-sdk/ui-utils": {
      "@ai-sdk/provider-utils": "5.0.5"
    },
    "@mastra/core": "1.25.0",
    "@mastra/core@1.25.0": {
      "@ai-sdk/provider-utils-v5": "npm:@ai-sdk/provider-utils@5.0.5",
      "@ai-sdk/ui-utils-v5": {
        "@ai-sdk/provider-utils": "5.0.5"
      }
    },
    "@mastra/server": "1.25.0",
    "esbuild": "0.28.1",
    "tsup": {
      "esbuild": "0.28.1"
    },
    "uuid": "11.1.1",
    "vite": "8.2.2",
    "react-router": "8.3.0",
    "@react-router/express": "8.3.0",
    "@react-router/node": "8.3.0",
    "@react-router/serve": "8.3.0"
  }
}

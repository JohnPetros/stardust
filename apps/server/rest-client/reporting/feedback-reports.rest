@URL = {{BASE_URL}}/reporting/feedback
@FEEDBACK_REPORT_ID = c582f971-6f9a-47bb-b3e2-ef36c124e145

### Send a feedback report
POST {{URL}}
Content-Type: application/json
Authorization: Bearer {{JWT}}

{
  "content": "Conteúdo do feedback de teste",
  "intent": "bug"
}

### List feedback reports
GET {{URL}}
?page=1
&itemsPerPage=10
Content-Type: application/json
Authorization: Bearer {{JWT}}

### Delete feedback report
DELETE {{URL}}/{{FEEDBACK_REPORT_ID}}
Content-Type: application/json
Authorization: Bearer {{JWT}}


### Send a feedback conversation message
POST {{URL}}/{{FEEDBACK_REPORT_ID}}/messages
Content-Type: application/json
Authorization: Bearer {{JWT}}

{
  "messageId": "e3abb326-d7e8-430f-9841-8b0d8b95f736",
  "content": "Mensagem de acompanhamento do feedback",
  "attachments": []
}

### Change feedback report status (God Account)
PATCH {{URL}}/{{FEEDBACK_REPORT_ID}}/status
Content-Type: application/json
Authorization: Bearer {{JWT}}

{
  "status": "closed",
  "expectedStatus": "open"
}

{
  "name": "@stardust/server",
  "main": "dist/main.js",
  "scripts": {
    "dev": "tsx watch --env-file .env.development src/main.ts",
    "lint": "biome lint src --diagnostic-level=error",
    "format": "biome format src --write",
    "check:code": "biome check src",
    "check:types": "tsc --noEmit",
    "check:updates": "ncu",
    "build": "tsup",
    "prod": "node --env-file .env build/main.js",
    "db:test": "supabase start --exclude studio,imgproxy,inbucket,edge-runtime,logflare,vector && supabase db reset --local --yes",
    "db:migrate": "supabase db diff -f $npm_config_schema_file",
    "db:prod": "supabase link --project-ref aukqejqsiqsqowafpppb",
    "db:dev": "supabase link --project-ref rveubqzvfbqbcpmuevnm",
    "db:pull": "supabase db pull --schema auth,public,storage,realtime",
    "db:push": "supabase db push",
    "db:types": "supabase gen types typescript --project-id rveubqzvfbqbcpmuevnm --schema auth,public,storage,realtime > src/database/supabase/types/Database.ts",
    "db:revert": "supabase migration repair --status reverted $npm_config_migration_id",
    "update": "ncu -u -f $npm_config_dep_name",
    "test:unit": "jest --selectProjects server",
    "test:integration": "jest --selectProjects server-integration"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1097.0",
    "@aws-sdk/s3-request-presigner": "^3.1097.0",
    "@hono/node-server": "^1.19.14",
    "@hono/zod-validator": "^0.9.0",
    "@mastra/core": "1.54.0",
    "@mastra/hono": "^1.5.11",
    "@sentry/node": "^10.68.0",
    "@stardust/core": "*",
    "@stardust/lsp": "*",
    "@stardust/validation": "*",
    "@supabase/ssr": "^0.12.4",
    "@supabase/supabase-js": "^2.49.4",
    "axios": "^1.18.1",
    "dropbox": "^10.38.0",
    "hono": "^4.12.32",
    "inngest": "^3.19.4",
    "ioredis": "^5.11.1",
    "jszip": "^3.10.1",
    "jwt-decode": "^4.0.0",
    "posthog-node": "^5.17.2",
    "zod": "^3.24.4"
  },
  "devDependencies": {
    "@types/jest": "^29.5.14",
    "@types/node": "^20.11.17",
    "@types/supertest": "^7.2.1",
    "jest": "^29.7.0",
    "jest-environment-node": "^30.4.1",
    "supabase": "^2.110.0",
    "supertest": "^7.2.2",
    "ts-jest": "^29.4.12",
    "ts-jest-mocker": "^1.3.0",
    "tsup": "^8.5.1",
    "tsx": "^4.7.1",
    "typescript": "^5.8.3"
  }
}

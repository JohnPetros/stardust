{
  "name": "@stardust/server",
  "main": "dist/main.js",
  "scripts": {
    "dev": "tsx watch --env-file .env.development src/main.ts",
    "codecheck": "npm run lint && npm run format",
    "lint": "biome lint src --diagnostic-level=error",
    "format": "biome format src --write",
    "build": "tsup",
    "prod": "node --env-file .env build/main.js",
    "db:local": "supabase start",
    "db:test": "npm run db:local && supabase db reset --local --yes",
    "db:migrate": "supabase db diff -f $npm_config_schema_file",
    "db:prod": "supabase link --project-ref aukqejqsiqsqowafpppb",
    "db:dev": "supabase link --project-ref rveubqzvfbqbcpmuevnm",
    "db:pull": "supabase db pull --schema auth,public,storage,realtime",
    "db:push": "supabase db push",
    "db:revert": "supabase migration repair --status reverted $npm_config_migration_id",
    "db:types": "supabase gen types typescript --project-id rveubqzvfbqbcpmuevnm --schema auth,public,storage,realtime > src/database/supabase/types/Database.ts",
    "update": "ncu -u -f $npm_config_dep_name",
    "check-updates": "ncu",
    "typecheck": "tsc --noEmit",
    "test:unit": "jest --selectProjects server",
    "test:integration": "jest --selectProjects server-integration"
  },
  "dependencies": {
    "@hono/node-server": "^1.19.14",
    "@hono/zod-validator": "^0.8.0",
    "@mastra/core": "1.50.0",
    "@mastra/hono": "^1.5.5",
    "@sentry/node": "^10.17.0",
    "@stardust/core": "*",
    "@stardust/validation": "*",
    "@supabase/ssr": "^0.12.0",
    "@supabase/supabase-js": "^2.49.4",
    "axios": "^1.18.1",
    "dropbox": "^10.34.0",
    "googleapis": "^153.0.0",
    "hono": "^4.12.28",
    "inngest": "^3.19.4",
    "ioredis": "^5.11.1",
    "jszip": "^3.10.1",
    "jwt-decode": "^4.0.0",
    "posthog-node": "^5.17.2",
    "zod": "^3.24.4"
  },
  "devDependencies": {
    "@types/jest": "^29.5.14",
    "@types/node": "^20.11.17",
    "@types/supertest": "^7.2.0",
    "jest": "^29.7.0",
    "jest-environment-node": "^29.7.0",
    "supabase": "^2.98.2",
    "supertest": "^7.2.2",
    "ts-jest": "^29.4.11",
    "ts-jest-mocker": "^1.3.0",
    "tsup": "^8.5.1",
    "tsx": "^4.7.1",
    "typescript": "^5.8.3"
  }
}

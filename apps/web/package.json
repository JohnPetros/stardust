{
  "name": "@stardust/web",
  "private": true,
  "scripts": {
    "dev": "cross-env NEXT_IGNORE_INCORRECT_LOCKFILE=1 next dev --port 3000",
    "queue": "npx inngest-cli@latest dev --no-discovery -u http://localhost:3000/api/serverless",
    "build": "cross-env NEXT_IGNORE_INCORRECT_LOCKFILE=1 next build",
    "start": "node .next/standalone/apps/web/server.js -p $PORT",
    "check:code": "biome check src",
    "check:types": "tsc --noEmit",
    "check:complexity": "node ../../scripts/check-complexity.mjs --scope apps/web",
    "check:architecture": "depcruise --config .dependency-cruiser.cjs src",
    "lint": "biome lint src --diagnostic-level=error",
    "format": "biome format src --write",
    "db:types": "supabase gen types typescript --project-id aukqejqsiqsqowafpppb > src/api/supabase/types/Database.ts",
    "test:unit": "jest",
    "test:coverage": "jest --coverage --coverageReporters=json-summary --coverageReporters=text-summary",
    "test:unit:watch": "jest --watchAll",
    "test:integration": "playwright test --config=playwright.config.ts",
    "test:integration:ui": "playwright test --config=playwright.config.ts --ui",
    "test:integration:debug": "playwright test --config=playwright.config.ts --debug",
    "test:integration:install": "playwright install chromium"
  },

{
  "name": "@stardust/lsp",
  "license": "MIT",
  "version": "0.1.0",
  "private": false,
  "main": "build/main.js",
  "module": "build/main.mjs",
  "author": {
    "name": "João Pedro Carvalho dos Santos"
  },
  "files": [
    "build"
  ],
  "publishConfig": {
    "access": "public"
  },
  "exports": {
    ".": {
      "types": "./src/main.ts",
      "require": "./build/main.js",
      "default": "./src/main.ts"
    }
  },
  "scripts": {
    "build": "tsup",
    "check:types": "tsc --noEmit",
    "check:code": "biome check src",
    "lint": "biome lint src/**/*.ts --diagnostic-level=error",
    "format": "biome format src/**/*.ts --write",
    "test:unit": "node --import tsx --test \"src/**/*.test.ts\""
  },
  "dependencies": {
    "@designliquido/delegua": "^1.25.1",
    "@stardust/core": "*",
    "monaco-editor": "^0.56.0"
  },
  "devDependencies": {
    "@stardust/typescript-config": "*",
    "tsup": "^8.5.1",
    "typescript": "5.5.3"
  }
}
